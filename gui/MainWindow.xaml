<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vivo English Kit" Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,5,16,5"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,5,0,5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,16">

    <!-- Header -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="8" Margin="0,0,16,0" x:Name="HeaderTile"
              Background="{DynamicResource AccentFillColorDefaultBrush}">
        <TextBlock x:Name="HeaderGlyph" Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" FontSize="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="vivo English Kit" FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock Text="Adds English to the Chinese vivo Office Kit."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Grid>

    <!--INFOBAR:Compat-->

    <!-- Installation status -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <TextBlock Text="Your installation" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          <Button x:Name="RefreshButton" HorizontalAlignment="Right" Padding="8,4" ToolTip="Check again"
                  Style="{DynamicResource DefaultButtonStyle}" AutomationProperties.Name="Refresh">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="Refresh" FontSize="12"/>
            </StackPanel>
          </Button>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Location" Style="{StaticResource Label}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PathText" Style="{StaticResource Value}"/>
          <TextBlock Grid.Row="1" Text="Build" Style="{StaticResource Label}"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock x:Name="BuildIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="BuildText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource Label}"/>
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock x:Name="VersionIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          </StackPanel>
          <TextBlock Grid.Row="3" Text="English support" Style="{StaticResource Label}"/>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock x:Name="PatchIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="PatchText" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          </StackPanel>
          <TextBlock Grid.Row="4" Text="Tested with" Style="{StaticResource Label}"/>
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,5">
            <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,1" Margin="0,0,0,4"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" x:Name="RecommendedBadge">
              <TextBlock Text="Recommended" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock x:Name="TestedText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Actions -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="Language" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
        <CheckBox x:Name="LabelsCheck" IsChecked="True" Margin="0,0,0,14"
                  Content="Also translate China-only labels that have no English text"/>
        <WrapPanel>
          <Button x:Name="InstallButton" Style="{DynamicResource AccentButtonStyle}" Padding="16,7" Margin="0,0,8,8" MinHeight="34">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="InstallButtonText" Text="Install English Language Support"/>
            </StackPanel>
          </Button>
          <Button x:Name="RestoreButton" Style="{DynamicResource DefaultButtonStyle}" Padding="16,7" Margin="0,0,8,8" MinHeight="34">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Restore Chinese"/>
            </StackPanel>
          </Button>
        </WrapPanel>

        <!-- Busy state -->
        <Grid x:Name="BusyPanel" Visibility="Collapsed" Margin="0,8,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Top">
            <Ellipse StrokeThickness="3" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.25"/>
            <Ellipse x:Name="Ring" StrokeThickness="3" StrokeDashArray="7 30" StrokeDashCap="Round"
                     Stroke="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="BusyTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="BusyDetail" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>

        <!--INFOBAR:Result-->

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,3,8,0"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <TextBlock Grid.Column="1" x:Name="NoteText" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Footer -->
    <Grid>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="LogButton" Style="{DynamicResource DefaultButtonStyle}" Padding="10,4" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="View log" FontSize="12"/>
          </StackPanel>
        </Button>
        <Button x:Name="FolderButton" Style="{DynamicResource DefaultButtonStyle}" Padding="10,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Open install folder" FontSize="12"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock x:Name="AdminText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Grid>
  </StackPanel>
</Window>
